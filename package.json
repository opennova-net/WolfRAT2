{
  "name": "wolfrat2-web-client",
  "version": "2.4.11",
  "private": true,
  "description": "Canonical browser-client validation commands for WolfRAT2",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "check": "node --check wolfrat/web_templates/app.js",
    "test": "node tests/web_client_result_test.js wolfrat/web_templates/app.js",
    "validate": "npm run check && npm test"
  }
}
